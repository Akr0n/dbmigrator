<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- The headless harness has one known way to hang (a second MainWindow in the same process never finishes building).
         A hung test host must turn into a failed run after ten minutes, not into a CI job that hangs until the 30-minute timeout of _build.yml and blocks the
         release workflow and every pull request. The whole UI suite takes a few seconds. -->
    <TestSessionTimeout>600000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
