<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- The headless harness has one known way to hang (a second MainWindow in the same process never finishes building).
         A hung test host must turn into a failed run after ten minutes, not into a six-hour CI job that also blocks the
         DEV workflow, whose -dev tag the production release depends on. The whole UI suite takes a few seconds. -->
    <TestSessionTimeout>600000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
